{
  "id": "host/an-unreadable-manifest-is-refused-and-the-rest-activate",
  "op": "host",
  "covers": "host",
  "given": {
    "stubHost": {
      "mode": "serve",
      "plugins": [
        {
          "name": "alpha",
          "directory": "alpha",
          "manifest": "alpha/manifest.json",
          "scope": true
        },
        {
          "name": "beta",
          "directory": "beta",
          "manifest": "beta/manifest.json",
          "scope": true
        }
      ]
    },
    "plugins": [
      {
        "name": "alpha",
        "unreadableManifest": true,
        "activate": [
          {
            "log": "up"
          }
        ]
      },
      {
        "name": "beta",
        "activate": [
          {
            "log": "up"
          }
        ]
      }
    ],
    "stopAfter": "tick 1 first"
  },
  "then": {
    "record": {
      "equals": [
        "start",
        "open beta scoped",
        "log beta info \"up\"",
        "started 2",
        "outcome alpha refused detail",
        "outcome beta activated no-detail",
        "tick 1 first",
        "stop"
      ]
    },
    "exit": 0
  }
}
