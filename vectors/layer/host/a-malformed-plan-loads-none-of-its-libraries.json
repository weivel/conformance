{
  "id": "host/a-malformed-plan-loads-none-of-its-libraries",
  "op": "host",
  "covers": "host",
  "given": {
    "stubHost": {
      "mode": "action",
      "plugins": [
        {
          "name": "alpha",
          "directory": "alpha",
          "manifest": "alpha/manifest.json",
          "scope": true
        }
      ],
      "action": {
        "plugin": "alpha",
        "name": "login",
        "service": "alpha:accounts"
      },
      "exit": 5,
      "libraries": [
        {
          "stubHostDeclaration": "library-declares-log.json"
        }
      ]
    },
    "plugins": [
      {
        "name": "alpha",
        "activate": [
          {
            "log": "up"
          }
        ],
        "provides": {
          "alpha:accounts": {
            "login": {
              "answer": "in"
            }
          }
        },
        "actions": {
          "login": {
            "answer": "from-actions"
          },
          "logout": {
            "answer": "from-actions"
          }
        }
      }
    ]
  },
  "then": {
    "record": {
      "equals": [
        "start",
        "stop"
      ]
    },
    "exit": 5
  }
}
