{
  "id": "host/a-method-run-whose-plugin-was-not-activated-reaches-finished-as-a-failure",
  "op": "host",
  "covers": "host",
  "given": {
    "stubHost": {
      "mode": "action",
      "plugins": [
        {
          "name": "alpha",
          "directory": "alpha",
          "manifest": "alpha/manifest.json",
          "scopeRefused": "alpha is not let in"
        }
      ],
      "action": {
        "plugin": "alpha",
        "name": "login",
        "service": "alpha:accounts",
        "method": "login"
      },
      "exit": 0
    },
    "plugins": [
      {
        "name": "alpha",
        "activate": [
          {
            "log": "up"
          }
        ],
        "provides": {
          "alpha:accounts": {
            "login": {
              "answer": "in"
            }
          }
        },
        "actions": {
          "login": {
            "answer": "from-actions"
          },
          "logout": {
            "answer": "from-actions"
          }
        }
      }
    ]
  },
  "then": {
    "record": {
      "equals": [
        "start",
        "open alpha refused",
        "started 1",
        "outcome alpha refused detail",
        "finished failure",
        "stop"
      ]
    },
    "exit": 0
  }
}
