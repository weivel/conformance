{
  "id": "host/an-action-runs-and-its-result-reaches-finished",
  "op": "host",
  "covers": "host",
  "given": {
    "stubHost": {
      "mode": "action",
      "plugins": [
        {
          "name": "alpha",
          "directory": "alpha",
          "manifest": "alpha/manifest.json",
          "scope": true
        }
      ],
      "action": {
        "plugin": "alpha",
        "name": "echo",
        "arguments": {
          "text": "hi",
          "times": [
            1,
            2
          ]
        }
      },
      "exit": 0
    },
    "plugins": [
      {
        "name": "alpha",
        "activate": [
          {
            "log": "up"
          }
        ],
        "actions": {
          "echo": {
            "echo": true
          },
          "quiet": {},
          "explode": {
            "throw": "it broke"
          },
          "answer": {
            "answer": 42
          }
        }
      }
    ]
  },
  "then": {
    "record": {
      "equals": [
        "start",
        "open alpha scoped",
        "log alpha info \"up\"",
        "started 1",
        "outcome alpha activated no-detail",
        "finished result {\"text\":\"hi\",\"times\":[1,2]}",
        "stop"
      ]
    },
    "exit": 0
  }
}
