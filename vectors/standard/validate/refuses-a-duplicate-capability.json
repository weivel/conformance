{
  "id": "validate/refuses-a-duplicate-capability",
  "op": "validate",
  "covers": "12.6",
  "given": {
    "schema": "plugin.schema.json",
    "manifest": {
      "importName": "config-ledger",
      "api": 2,
      "entry": "dist/index.js",
      "capabilities": {
        "provides": [
          "provider",
          "provider"
        ]
      }
    }
  },
  "then": {
    "valid": false,
    "paths": {
      "equals": [
        "capabilities.provides[1]"
      ]
    }
  }
}
