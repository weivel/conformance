{
  "id": "library/a-library-with-a-bytes-function-still-needs-its-release",
  "op": "library",
  "covers": "12.6",
  "given": {
    "declaration": {
      "importName": "echo",
      "version": "0.2.0",
      "services": [
        {
          "id": "echo",
          "functions": [
            {
              "name": "definition",
              "symbol": "echo_service_definition",
              "kind": "definition"
            }
          ]
        },
        {
          "id": "echo-bytes",
          "functions": [
            {
              "name": "echo",
              "symbol": "echo_echo",
              "kind": "bytes"
            }
          ]
        }
      ]
    }
  },
  "then": {
    "read": false,
    "path": "release",
    "refusal": {
      "code": "missing_field"
    }
  }
}
