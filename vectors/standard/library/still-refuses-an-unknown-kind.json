{
  "id": "library/still-refuses-an-unknown-kind",
  "op": "library",
  "covers": "12.6",
  "given": {
    "declaration": {
      "importName": "echo",
      "version": "0.2.0",
      "release": "echo_release",
      "services": [
        {
          "id": "echo",
          "functions": [
            {
              "name": "definition",
              "symbol": "echo_service_definition",
              "kind": "struct"
            }
          ]
        }
      ]
    }
  },
  "then": {
    "read": false,
    "path": "services[0].functions[0].kind",
    "refusal": {
      "code": "invalid_value"
    }
  }
}
