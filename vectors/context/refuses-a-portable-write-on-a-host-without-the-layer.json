{
  "id": "context/refuses-a-portable-write-on-a-host-without-the-layer",
  "op": "context",
  "covers": "invariant-13",
  "given": {
    "host": {
      "portable": null,
      "secrets": false
    },
    "write": {
      "key": "theme",
      "value": "dark",
      "layer": "portable"
    }
  },
  "then": {
    "portable": {
      "absent": true
    },
    "secrets": {
      "equals": false
    },
    "written": {
      "absent": true
    },
    "refusal": {
      "mentions": [
        "this host has no portable settings layer"
      ],
      "hasFix": true
    }
  }
}
