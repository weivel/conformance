{
  "id": "consume/lets-a-plugin-reach-a-capability-it-provides",
  "op": "consume",
  "covers": "invariant-14",
  "given": {
    "plugins": [
      {
        "id": "calendar",
        "capabilities": {
          "provides": [
            "screens"
          ],
          "consumes": []
        }
      }
    ],
    "steps": [
      {
        "plugin": "calendar",
        "watch": "screens"
      },
      {
        "plugin": "calendar",
        "provide": "screens"
      },
      {
        "plugin": "calendar",
        "verify": true
      },
      {
        "plugin": "calendar",
        "all": "screens"
      }
    ]
  },
  "then": {
    "outcomes": {
      "equals": [
        [
          "calendar"
        ]
      ]
    },
    "heard": {
      "equals": [
        [
          [
            "calendar",
            "provide"
          ]
        ]
      ]
    },
    "reported": {
      "equals": []
    },
    "refusal": null
  }
}
