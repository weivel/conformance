{
  "id": "validate/reports-two-bad-setting-keys-once",
  "op": "validate",
  "covers": "12.6",
  "given": {
    "schema": "https://weivel.github.io/model/plugin.schema.json",
    "manifest": {
      "importName": "demo",
      "api": 2,
      "services": {
        "provides": [
          "demo:screens"
        ]
      },
      "settings": {
        "Bad-Key": {
          "type": "text",
          "label": "Bad"
        },
        "9lives": {
          "type": "text",
          "label": "Lives"
        }
      }
    },
    "wellKnownServices": []
  },
  "then": {
    "valid": false,
    "paths": {
      "equals": [
        "settings"
      ]
    }
  }
}
