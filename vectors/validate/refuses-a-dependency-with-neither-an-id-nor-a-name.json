{
  "id": "validate/refuses-a-dependency-with-neither-an-id-nor-a-name",
  "op": "validate",
  "covers": "12.6",
  "given": {
    "schema": "https://weivel.github.io/model/plugin.schema.json",
    "manifest": {
      "importName": "a",
      "api": 2,
      "dependencies": [
        { "importName": "runtime" }
      ]
    }
  },
  "then": {
    "valid": false,
    "paths": {
      "equals": [
        "dependencies[0].name"
      ]
    }
  }
}
