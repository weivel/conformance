{
  "id": "validate/refuses-a-bare-service-id-that-is-not-well-known",
  "op": "validate",
  "covers": "12.6",
  "given": {
    "schema": "https://weivel.github.io/model/plugin.schema.json",
    "manifest": {
      "id": "a",
      "api": 2,
      "services": {
        "provides": [
          "routing"
        ]
      }
    },
    "wellKnownServices": [
      "accounts"
    ]
  },
  "then": {
    "valid": false,
    "paths": {
      "equals": [
        "services.provides[0]"
      ]
    },
    "refusal": {
      "hasFix": true
    }
  }
}
