{
  "id": "validate/refuses-a-binding-to-a-consumed-service",
  "op": "validate",
  "covers": "12.6",
  "given": {
    "schema": "https://weivel.github.io/model/plugin.schema.json",
    "manifest": {
      "id": "demo",
      "api": 2,
      "services": {
        "provides": [
          "demo:screens"
        ],
        "consumes": [
          "other:thing"
        ]
      },
      "actions": {
        "refresh": {
          "label": "Refresh",
          "call": {
            "service": "other:thing",
            "method": "refresh"
          }
        }
      }
    },
    "wellKnownServices": []
  },
  "then": {
    "valid": false,
    "paths": {
      "equals": [
        "actions.refresh.call.service"
      ]
    }
  }
}
