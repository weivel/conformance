{
  "id": "validate/accepts-a-well-known-bare-service-id",
  "op": "validate",
  "covers": "12.6",
  "given": {
    "schema": "https://weivel.github.io/model/plugin.schema.json",
    "manifest": {
      "id": "a",
      "api": 2,
      "services": {
        "provides": [
          "accounts"
        ]
      }
    },
    "wellKnownServices": [
      "accounts"
    ]
  },
  "then": {
    "valid": true
  }
}
