{
  "id": "validate/refuses-a-pixel-size",
  "op": "validate",
  "covers": "12.6",
  "given": {
    "schema": "https://weivel.github.io/model/plugin.schema.json",
    "manifest": {
      "id": "demo",
      "api": 2,
      "services": {
        "provides": [
          "demo:screens"
        ]
      },
      "views": {
        "main": {
          "title": "Main",
          "nodes": [
            {
              "id": "root",
              "component": "stack",
              "size": "13px"
            }
          ]
        }
      }
    },
    "wellKnownServices": []
  },
  "then": {
    "valid": false,
    "paths": {
      "equals": [
        "views.main.nodes[0].size"
      ]
    }
  }
}
