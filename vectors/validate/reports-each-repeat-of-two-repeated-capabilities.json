{
  "id": "validate/reports-each-repeat-of-two-repeated-capabilities",
  "op": "validate",
  "covers": "12.6",
  "given": {
    "schema": "https://weivel.github.io/model/plugin.schema.json",
    "manifest": {
      "id": "config-ledger",
      "api": 2,
      "entry": "dist/index.js",
      "capabilities": [
        "provider",
        "consumer",
        "provider",
        "consumer"
      ]
    }
  },
  "then": {
    "valid": false,
    "paths": {
      "equals": [
        "capabilities[2]",
        "capabilities[3]"
      ]
    }
  }
}
