{
  "id": "resolve/refuses-when-never-satisfied-and-not-degradable",
  "op": "resolve",
  "covers": "12.4",
  "given": {
    "requirement": {
      "id": "storage.object",
      "constraints": {
        "minReplicas": 3
      },
      "degradable": false
    },
    "provider": {
      "advertised": {
        "maxReplicas": 1
      },
      "attributesByPoll": [
        {
          "maxReplicas": 1
        }
      ]
    },
    "budgetMillis": 2000,
    "pollMillis": 1000
  },
  "then": {
    "served": false,
    "degraded": false,
    "refusal": {
      "mentions": [
        "minReplicas",
        "maxReplicas",
        "2000"
      ]
    }
  }
}
