# -DBUDGET=<file> -DEXPECTED=<valid|invalid> [-DMUST_MATCH=<regex>]
#
# Reads a language's budget file as RUNNER.md states its format, so a malformed line fails here rather than in the
# benchmark test of the one language that reads it.

cmake_minimum_required(VERSION 3.15)

set(ratio_gates control-call library-call)
set(platforms linux windows macos)
set(scalars ratio-margin quiet-noise worst-noise noise-margin)
set(number "^[0-9]+(\\.[0-9]+)?$")

set(problems "")
set(seen "")
if(NOT EXISTS "${BUDGET}")
    list(APPEND problems "${BUDGET} does not exist")
else()
    file(STRINGS "${BUDGET}" lines)
    if(lines STREQUAL "")
        list(APPEND problems "${BUDGET} holds no line")
    endif()
    foreach(line IN LISTS lines)
        string(REGEX REPLACE "\r$" "" line "${line}")
        string(REPLACE " " ";" fields "${line}")
        list(LENGTH fields count)
        set(key "")
        set(value "")
        if(count EQUAL 3)
            list(GET fields 0 gate)
            list(GET fields 1 platform)
            list(GET fields 2 value)
            if(NOT gate IN_LIST ratio_gates)
                list(APPEND problems "'${line}' names no ratio gate")
            elseif(NOT platform IN_LIST platforms)
                list(APPEND problems "'${line}' names no known platform")
            else()
                set(key "${gate} ${platform}")
            endif()
        elseif(count EQUAL 2)
            list(GET fields 0 name)
            list(GET fields 1 value)
            if(NOT name IN_LIST scalars)
                list(APPEND problems "'${line}' names no known bound")
            else()
                set(key "${name}")
            endif()
        else()
            list(APPEND problems "'${line}' is neither '<gate> <platform> <number>' nor '<bound> <number>'")
        endif()
        if(NOT key STREQUAL "")
            if(NOT value MATCHES "${number}" OR value MATCHES "^0+(\\.0+)?$")
                list(APPEND problems "'${line}' carries no positive number")
            elseif(key IN_LIST seen)
                list(APPEND problems "'${key}' is given twice")
            else()
                list(APPEND seen "${key}")
            endif()
        endif()
    endforeach()
    foreach(gate IN LISTS ratio_gates)
        foreach(platform IN LISTS platforms)
            if(NOT "${gate} ${platform}" IN_LIST seen)
                list(APPEND problems "'${gate} ${platform}' is missing")
            endif()
        endforeach()
    endforeach()
    foreach(name IN LISTS scalars)
        if(NOT name IN_LIST seen)
            list(APPEND problems "'${name}' is missing")
        endif()
    endforeach()
endif()

string(REPLACE ";" "\n" report "${problems}")
if(EXPECTED STREQUAL "valid" AND NOT problems STREQUAL "")
    message(FATAL_ERROR "${BUDGET} is not a usable budget:\n${report}")
endif()
if(EXPECTED STREQUAL "invalid")
    if(problems STREQUAL "")
        message(FATAL_ERROR "${BUDGET} was accepted, and it should not have been")
    endif()
    if(DEFINED MUST_MATCH AND NOT report MATCHES "${MUST_MATCH}")
        message(FATAL_ERROR "the refusal of ${BUDGET} does not match '${MUST_MATCH}':\n${report}")
    endif()
endif()
