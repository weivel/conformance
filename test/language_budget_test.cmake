# -DBUDGET=<file> -DEXPECTED=<valid|invalid> [-DMUST_MATCH=<regex>] [-DLANGUAGE=<name> -DLANGUAGES=<languages.txt>]
#
# Reads a language's budget file as docs/benchmarks.md states its format, so a malformed line fails here rather than in
# the benchmark test of the one language that reads it. A ratio gate may name a backend after a hyphen, and every
# backend a file names carries both required ratio gates on every platform; a file names a backend on every ratio gate
# or on none. An optional ratio gate need not appear, and once it appears on one platform or backend it appears on every
# platform of every backend the file names. Given the language, `described-call` is required unless the languages list
# exempts the language from `description/binding`, since every other language binds descriptions.

cmake_minimum_required(VERSION 3.15)

set(ratio_gates control-call library-call)
if(DEFINED LANGUAGE)
    file(STRINGS "${LANGUAGES}" language_lines)
    set(binds_descriptions TRUE)
    foreach(language_line IN LISTS language_lines)
        string(REGEX REPLACE "$" "" language_line "${language_line}")
        if(language_line STREQUAL "${LANGUAGE} layer-exempt description/binding")
            set(binds_descriptions FALSE)
        endif()
    endforeach()
    if(binds_descriptions)
        list(APPEND ratio_gates described-call)
    endif()
endif()
set(ratio_gate_name "^(control-call|library-call|described-call|blocking-call)(-[a-z0-9]+)?$")
set(named_bases "")
set(noise_bounds quiet-noise worst-noise noise-margin)
set(platforms linux windows macos)
set(scalars ratio-margin)
set(number "^[0-9]+(\\.[0-9]+)?$")

set(problems "")
set(seen "")
set(backends "")
if(NOT EXISTS "${BUDGET}")
    list(APPEND problems "${BUDGET} does not exist")
else()
    file(STRINGS "${BUDGET}" lines)
    if(lines STREQUAL "")
        list(APPEND problems "${BUDGET} holds no line")
    endif()
    foreach(line IN LISTS lines)
        string(REGEX REPLACE "\r$" "" line "${line}")
        string(REPLACE " " ";" fields "${line}")
        list(LENGTH fields count)
        set(key "")
        set(value "")
        if(count EQUAL 3)
            list(GET fields 0 name)
            list(GET fields 1 platform)
            list(GET fields 2 value)
            set(known FALSE)
            if(name IN_LIST noise_bounds)
                set(known TRUE)
            elseif(name MATCHES "${ratio_gate_name}")
                set(known TRUE)
                list(APPEND backends "backend${CMAKE_MATCH_2}")
                list(APPEND named_bases "${CMAKE_MATCH_1}")
            endif()
            if(NOT known)
                list(APPEND problems "'${line}' names no ratio gate or noise bound")
            elseif(NOT platform IN_LIST platforms)
                list(APPEND problems "'${line}' names no known platform")
            else()
                set(key "${name} ${platform}")
            endif()
        elseif(count EQUAL 2)
            list(GET fields 0 name)
            list(GET fields 1 value)
            if(NOT name IN_LIST scalars)
                list(APPEND problems "'${line}' names no known margin")
            else()
                set(key "${name}")
            endif()
        else()
            list(APPEND problems "'${line}' is neither '<gate or noise> <platform> <number>' nor '<margin> <number>'")
        endif()
        if(NOT key STREQUAL "")
            if(NOT value MATCHES "${number}" OR value MATCHES "^0+(\\.0+)?$")
                list(APPEND problems "'${line}' carries no positive number")
            elseif(key IN_LIST seen)
                list(APPEND problems "'${key}' is given twice")
            else()
                list(APPEND seen "${key}")
            endif()
        endif()
    endforeach()
    if(backends STREQUAL "")
        set(backends "backend")
    endif()
    list(REMOVE_DUPLICATES backends)
    list(LENGTH backends backend_count)
    if("backend" IN_LIST backends AND backend_count GREATER 1)
        list(APPEND problems "${BUDGET} names ratio gates both with and without a backend")
    endif()
    set(required "")
    foreach(backend IN LISTS backends)
        string(REGEX REPLACE "^backend" "" suffix "${backend}")
        foreach(gate IN LISTS ratio_gates named_bases)
            list(APPEND required "${gate}${suffix}")
        endforeach()
    endforeach()
    list(APPEND required ${noise_bounds})
    list(REMOVE_DUPLICATES required)
    foreach(name IN LISTS required)
        foreach(platform IN LISTS platforms)
            if(NOT "${name} ${platform}" IN_LIST seen)
                list(APPEND problems "'${name} ${platform}' is missing")
            endif()
        endforeach()
    endforeach()
    foreach(name IN LISTS scalars)
        if(NOT name IN_LIST seen)
            list(APPEND problems "'${name}' is missing")
        endif()
    endforeach()
endif()

string(REPLACE ";" "\n" report "${problems}")
if(EXPECTED STREQUAL "valid" AND NOT problems STREQUAL "")
    message(FATAL_ERROR "${BUDGET} is not a usable budget:\n${report}")
endif()
if(EXPECTED STREQUAL "invalid")
    if(problems STREQUAL "")
        message(FATAL_ERROR "${BUDGET} was accepted, and it should not have been")
    endif()
    if(DEFINED MUST_MATCH AND NOT report MATCHES "${MUST_MATCH}")
        message(FATAL_ERROR "the refusal of ${BUDGET} does not match '${MUST_MATCH}':\n${report}")
    endif()
endif()
