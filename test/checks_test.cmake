    plant("CONTENT.md" "line one\nsee ${second_name} for more")
    plant("${hosting_directory}/workflows/test.yml" "uses: ${first_name}")
    plant("LICENSE" "Copyright ${first_name}")
    plant(".weivel/repo.json" "{\"id\": \"${hosting_directory}:1\"}")
