    plant("empty-words.txt" "\n  \n")
    expect(2 "no words" "" ${NAMES} ${root} ${root}/empty-words.txt)
elseif(SCENARIO STREQUAL "names_rejects_a_forbidden_package_key_in_a_lockfile")
    plant("package-lock.json" "{\"name\": \"app\", \"lockfileVersion\": 3, \"packages\": {\"\": {\"dependencies\": {\"left\": \"1.0.0\"}}, \"node_modules/@${first_name}/left\": {\"version\": \"1.0.0\"}}}")
    expect(1 "package-lock\\.json: packages.*node_modules/@${first_name}/left.* names '${first_name}'" "" ${NAMES} ${root} ${WORDS})
elseif(SCENARIO STREQUAL "names_rejects_a_forbidden_origin_in_a_lockfile")
