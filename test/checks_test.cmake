    plant(".vscode/x.ts" "x")
    plant(".cache/engine.js" "x")
    expect(1 "\\.cache/engine\\.js.*\\.vscode/x\\.ts" "engine\\.c:" ${PURITY} ${root} c ${LANGUAGES})
elseif(SCENARIO STREQUAL "purity_rejects_language_build_files_in_a_c_repo")
