    expect(1 "legacy/build\\.gradle.*package\\.json.*tools/package-lock\\.json.*web/tsconfig\\.base\\.json" "engine\\.c:" ${PURITY} ${root} kit ${LANGUAGES})
elseif(SCENARIO STREQUAL "purity_refuses_an_empty_directory")
    expect(2 "nothing was checked" "" ${PURITY} ${root} c ${LANGUAGES})
elseif(SCENARIO STREQUAL "purity_refuses_an_unknown_role")
