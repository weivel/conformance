    plant_modules("core;handles;context;host;conformance;benchmarks")
    expect(1 "missing required module 'timer'" "'standard'" ${PARITY} ${root} ${MODULES} typescript ${LANGUAGES})
elseif(SCENARIO STREQUAL "parity_rejects_a_module_not_on_the_list")
