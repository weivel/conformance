    plant("package-lock.json" "{\"name\": \"app\", \"lockfileVersion\": 3, \"packages\": {\"node_modules/left\": {\"version\": \"1.0.0\", \"resolved\": \"https://registry.example/left.tgz\", \"integrity\": \"sha512-${first_name}\", \"license\": \"${first_name}\", \"funding\": {\"type\": \"${second_word}\", \"url\": \"https://${second_word}.example/sponsors\"}}}}")
