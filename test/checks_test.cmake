    plant("words.txt" "zzqx\n")
    expect(0 "carry none of" "" ${NAMES} ${root} ${root}/words.txt)
elseif(SCENARIO STREQUAL "names_skips_by_name_only_at_the_root")
    plant("src/a.c" "int x;")
