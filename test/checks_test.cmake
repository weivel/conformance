    plant("src/build/z.ts" "x")
    plant("src/node_modules/y.ts" "x")
    plant("src/siblings/w.ts" "x")
    expect(1 "src/build/z\\.ts.*src/builder/x\\.ts.*src/node_modules/y\\.ts.*src/siblings/w\\.ts"
        "out\\.js|engine\\.c:" ${PURITY} ${root} c ${LANGUAGES})
elseif(SCENARIO STREQUAL "purity_rejects_editor_and_cache_directories")
