    plant("CONTENT.md" "prose")
    expect(0 "checks/names\\.txt: skipped as a copy of the word list" "names '" ${NAMES} ${root} ${WORDS})
elseif(SCENARIO STREQUAL "names_reads_a_list_that_is_not_its_word_list")
