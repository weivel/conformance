# -DSCENARIO=<name> -DWORK=<dir> -DPURITY=<exe> -DNAMES=<exe> -DPARITY=<exe> -DLAYERS=<exe> -DLANGUAGES=<file>
# -DWORDS=<file> -DMODULES=<file> -DOPAQUE=<dir>
#
# Every planted violation is written into WORK at test time. A committed file naming a forbidden word or carrying
# the wrong language would make the kit's own checks fail on the kit.

set(root "${WORK}/${SCENARIO}")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}")

# Spelled in pieces because the names gate reads this file and would refuse the words it plants.
string(CONCAT hosting_directory ".git" "hub")
string(CONCAT first_name "spi" "sor")
string(CONCAT second_name "Git" "Hub")
string(TOLOWER "${second_name}" second_word)

function(plant relative content)
    file(WRITE "${root}/${relative}" "${content}")
endfunction()

function(expect expected_exit must_match must_not_match)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
    set(output "${out}${err}")
    if(NOT code STREQUAL expected_exit)
        message(FATAL_ERROR "${SCENARIO}: exit ${code}, expected ${expected_exit}\n${output}")
    endif()
    if(NOT must_match STREQUAL "" AND NOT output MATCHES "${must_match}")
        message(FATAL_ERROR "${SCENARIO}: output does not match '${must_match}'\n${output}")
    endif()
    if(NOT must_not_match STREQUAL "" AND output MATCHES "${must_not_match}")
        message(FATAL_ERROR "${SCENARIO}: output matches '${must_not_match}'\n${output}")
    endif()
endfunction()

function(plant_layer_vectors ids)
    plant("layer/LAYER.md" "prose naming no vector")
    foreach(id IN LISTS ids)
        plant("layer/${id}.json" "{\"id\": \"${id}\"}")
    endforeach()
endfunction()

function(plant_modules names)
    foreach(name IN LISTS names)
        file(MAKE_DIRECTORY "${root}/src/${name}")
        file(WRITE "${root}/src/${name}/keep.txt" "x")
    endforeach()
endfunction()

function(plant_c_layer)
    plant("CMakeLists.txt" "")
    plant("CONTENT.md" "prose")
    plant(".weivel/repo.json" "{}")
    plant("include/weivel/c.h" "")
    plant("include/weivel/c/core.h" "")
    plant("test/CMakeLists.txt" "")
    plant("test/core/load_test.c" "int main(void) { return 0; }")
    plant("test/core/exports_check.cmake" "")
    foreach(name core handles timer context host standard conformance benchmarks)
        plant("src/${name}/${name}.c" "int x;")
    endforeach()
endfunction()

function(plant_java_layer)
    foreach(name build.gradle settings.gradle gradle.properties gradlew gradlew.bat)
        plant("${name}" "")
    endforeach()
    plant("gradle/wrapper/gradle-wrapper.properties" "")
    plant("CONTENT.md" "prose")
    plant(".weivel/repo.json" "{}")
    foreach(name core handles timer context host standard conformance benchmarks)
        plant("src/main/java/com/weivel/${name}/package-info.java" "package com.weivel.${name};")
        plant("src/test/java/com/weivel/${name}/Test.java" "package com.weivel.${name}; class Test {}")
    endforeach()
    plant("src/main/java/com/weivel/host/internal/Lock.java" "package com.weivel.host.internal; class Lock {}")
    plant("src/plugins/java/com/weivel/fixtures/Plugin.java" "package com.weivel.fixtures; class Plugin {}")
endfunction()

