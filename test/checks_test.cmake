    expect(1 "include/api.h:1.*names '${first_name}'" "workflows|LICENSE|repo.json|clean.txt" ${NAMES} ${root} ${WORDS})
    expect(1 "CONTENT.md:2.*names '${second_word}'" "workflows|LICENSE|repo.json" ${NAMES} ${root} ${WORDS})
elseif(SCENARIO STREQUAL "names_accepts_a_clean_tree")
